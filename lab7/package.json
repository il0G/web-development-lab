{
  "name": "lab7-scss",
  "version": "1.0.0",
  "description": "Лаб 7: Sass/SCSS refactor (Лаб 6-ийн сайт)",
  "scripts": {
    "build:dev": "sass --style=expanded scss/main.scss css/style.css",
    "build": "sass --style=compressed --no-source-map scss/main.scss css/style.min.css",
    "watch": "sass --watch --style=expanded scss/main.scss:css/style.css",
    "clean": "rm -f css/style.css css/style.css.map css/style.min.css"
  },
  "devDependencies": {
    "sass": "^1.107.1"
  },
  "private": true
}
